{
  "firestore": {
    "rules": "firestore.rules",
    "predeploy": ["node tools/check-project.mjs"]
  },
  "functions": {
    "source": "_functions/functions",
    "runtime": "nodejs22",
    "predeploy": [
      "node tools/check-project.mjs",
      "npm install --prefix _functions/functions --no-audit --no-fund",
      "node tools/sync-engine.mjs"
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
