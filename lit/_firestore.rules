rules_version = '2';

// Firestore security rules for The Lit paper-browser accounts.
// Every signed-in user can read and write ONLY their own data subtree, so each
// person's saved papers, notes, lists, tags and e-mail alerts are private to
// them. The recursive wildcard below already covers the alerts subcollection
// (users/{uid}/alerts/*) and the one-off test-e-mail queue
// (users/{uid}/testEmails/*), so no extra rule is needed for E-mail alerts. The
// alert mailer (see _EMAIL-ALERTS-SETUP.md) reads both server-side with the
// Admin SDK, which bypasses these rules. Deploy with:
//   firebase deploy --only firestore:rules
// (or paste into Firebase console -> Firestore Database -> Rules -> Publish).

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public registered-users tally (counted by lit/analytics/). Each account
    // owns exactly ONE doc here, keyed by its uid and holding only a coarse
    // "last seen" timestamp `t` — no e-mail, name or any private data. It is
    // publicly readable so the static analytics page can COUNT the collection
    // (the number of docs = number of registered users); each user may only
    // create/update their OWN doc, the payload is pinned to just `t`, and nobody
    // can delete. No user's private subtree above is exposed by this.
    //
    // NOTE: this stays `read: if true` (get+list) deliberately — the analytics
    // page derives the user count with a count() aggregation, which is evaluated
    // under the SAME read rules as the underlying query, so there is no
    // "count without list" permission to trim to. That means the collection is
    // enumerable (uids + coarse `t` timestamps, nothing more). To close that
    // without losing the count, replace these per-user public docs with a single
    // counter document incremented by a Cloud Function (Admin SDK) and drop
    // public read — a follow-up, not done here to avoid breaking the live tile.
    //
    // DELETE is allowed for the OWNER of the marker, and only for them. A
    // sign-in that goes away must stop being counted: the duplicate-account
    // merge deletes the account it merges AWAY (acctStartMerge), and deleting a
    // Firebase sign-in does not touch its Firestore data — so with `delete: if
    // false` the merged-away account's marker stayed here for ever and the
    // "Registered users" tile went on counting one person as two. The merge
    // retires its own marker just before it deletes the sign-in (the same
    // "while we can still write as this user" reasoning as deleteOwnAlerts),
    // and re-writes it if the deletion then fails. Nobody can delete anyone
    // else's marker, so this cannot be used to deflate the tally.
    match /registeredUsers/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['t']);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Duplicate-account detection (same person, two accounts). Each signed-in
    // session claims its identity keys — "orcid:<iD>" and "email:<sha256 of
    // the lowercased address>" — mapping the key to the owning uid. A later
    // sign-in whose key is already claimed by a DIFFERENT uid is a duplicate,
    // and the page offers the merge flow. Read is `get` ONLY (a point look-up
    // of one known key), never `list`: `read` in Firestore covers get+list, and
    // an unrestricted list would let ANY signed-in user page the whole
    // collection and harvest every account's ORCID iD plus offline-crack the
    // sha256 email hashes. All conflict checks read a single key by id, so
    // get-only is sufficient. Create/update must claim your own uid; never
    // deletable.
    match /accountKeys/{key} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.data.keys().hasOnly(['uid', 't'])
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Public shared lists. A signed-in user can make one of their saved-paper
    // lists public (main page → My Library → a list's 🔗 Share → "Make public").
    // We store a denormalized, read-only snapshot here — keyed by an unguessable
    // random share id — because a viewer cannot read the owner's private
    // users/{uid}/** subtree. It carries ONLY bibliographic fields (each paper's
    // title/authors/year/DOI), never the owner's private note or tags. Anyone
    // (even signed-out) may READ a shared list by its id; only the owner may
    // create/update/delete their own, and the payload is bounded so it can't be
    // abused as free public storage. Turning the list private again deletes the
    // doc, so the old link stops resolving.
    //
    // Read is `get` ONLY, never `list`: a shared list is opened by its known,
    // unguessable share id (a point read), so `list: false` keeps the
    // "unguessable id" actually private — otherwise `read: if true` lets anyone
    // enumerate every shared list (and each owner's display name) regardless of
    // the id.
    match /publicLists/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid
                    && request.resource.data.keys().hasOnly(
                         ['ownerUid','owner','name','count','papers','createdAt','updatedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.papers is list
                    && request.resource.data.papers.size() <= 5000;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid
                    && request.auth.uid == request.resource.data.ownerUid
                    && request.resource.data.keys().hasOnly(
                         ['ownerUid','owner','name','count','papers','createdAt','updatedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.papers is list
                    && request.resource.data.papers.size() <= 5000;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // Feedback inbox (written by the standalone /lit/feedback/ page). Anyone may
    // CREATE a bounded feedback document (a short message, its generated ticket
    // number and a few client-compressed screenshots as data URLs). It is NOT
    // publicly readable: only the site maintainer — signed in as the admin
    // account — may READ the inbox and mark a submission complete (update) or
    // DELETE it. That is what powers the admin dashboard shown on the Feedback
    // page for that one account (kstouras@gmail.com). The server mailers and the
    // GitHub logger use the Admin SDK, which bypasses these rules. Bounds below
    // keep the collection from being abused as free public storage.
    function isFeedbackAdmin() {
      return request.auth != null
             && request.auth.token.email == 'kstouras@gmail.com'
             && request.auth.token.email_verified == true;
    }
    // HARDENING FOLLOW-UP (console-side, not done in these rules because it would
    // break the deliberately no-sign-in feedback form until the page + project
    // are updated together): create is open to anyone, and Firestore rules can't
    // iterate list elements to cap each screenshot's bytes, so the realistic
    // defence against storage/billing/spam abuse is (1) enable Firebase App Check
    // (reCAPTCHA) and add `&& request.app != null` here, (2) have the feedback
    // page sign in anonymously and add `&& request.auth != null`, (3) set a Google
    // Cloud billing budget + alert. The per-field size caps below are the part
    // that is safe to ship now — they bound the maximum abusive document without
    // rejecting any legitimate submission.
    match /feedback/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['text','images','name','email','uid','ticket','page','url','ua','forwarded','status','createdAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 20000
                    && (!('images' in request.resource.data)
                        || (request.resource.data.images is list
                            && request.resource.data.images.size() <= 5))
                    && (!('name' in request.resource.data)
                        || (request.resource.data.name is string && request.resource.data.name.size() <= 200))
                    && (!('email' in request.resource.data)
                        || (request.resource.data.email is string && request.resource.data.email.size() <= 320))
                    && (!('ticket' in request.resource.data)
                        || (request.resource.data.ticket is string && request.resource.data.ticket.size() <= 64))
                    && (!('page' in request.resource.data)
                        || (request.resource.data.page is string && request.resource.data.page.size() <= 300))
                    && (!('url' in request.resource.data)
                        || (request.resource.data.url is string && request.resource.data.url.size() <= 2000))
                    && (!('ua' in request.resource.data)
                        || (request.resource.data.ua is string && request.resource.data.ua.size() <= 1000))
                    && request.resource.data.forwarded == false;
      allow read:           if isFeedbackAdmin();
      allow update, delete: if isFeedbackAdmin();
    }

    // Paper submissions (written by the "Suggest a missing published Paper or a
    // Working Paper" section of the /lit/feedback/ page). A SIGNED-IN user may
    // CREATE one bounded submission claiming their own uid, with `status` pinned
    // to 'pending' on create (so the client can't pre-mark it added/rejected —
    // only the server ingest does that). `kind` ('published') and `citation`
    // (the pasted full reference) are the published-paper form's extra fields —
    // both optional, both hints the ingest never trusts into any dataset.
    // The submitter may READ their own submissions (to see the outcome); only the
    // maintainer admin may read the whole queue and update/delete it. The server
    // ingest (lit/_scraper-workingpapers/ingest-submissions.mjs) uses the Admin
    // SDK, which bypasses these rules. Bounds keep it from being abused as storage.
    match /paperSubmissions/{docId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.keys().hasOnly(
                         ['uid','email','name','url','title','authors','note','kind','citation','ticket','status','createdAt'])
                    && request.resource.data.url is string
                    && request.resource.data.url.size() <= 2000
                    && (!('email' in request.resource.data)
                        || (request.resource.data.email is string && request.resource.data.email.size() <= 320))
                    && (!('name' in request.resource.data)
                        || (request.resource.data.name is string && request.resource.data.name.size() <= 200))
                    && (!('title' in request.resource.data)
                        || (request.resource.data.title is string && request.resource.data.title.size() <= 500))
                    && (!('authors' in request.resource.data)
                        || (request.resource.data.authors is string && request.resource.data.authors.size() <= 2000))
                    && (!('note' in request.resource.data)
                        || (request.resource.data.note is string && request.resource.data.note.size() <= 5000))
                    && (!('kind' in request.resource.data)
                        || request.resource.data.kind in ['wp', 'published'])
                    && (!('citation' in request.resource.data)
                        || (request.resource.data.citation is string && request.resource.data.citation.size() <= 4000))
                    && request.resource.data.status == 'pending';
      allow read:           if isFeedbackAdmin()
                            || (request.auth != null && request.auth.uid == resource.data.uid);
      allow update, delete: if isFeedbackAdmin();
    }

    // ─── What's new: the maintainer's decision about each changelog entry ────
    //
    // lit/changelog.json stays the source of truth for WHAT was announced. One
    // document here per changelog entry id says what has been DONE about it:
    //
    //   status: 'approved'   published — every visitor sees it
    //   status: 'pending'    not reviewed yet — only the maintainer sees it
    //   status: 'removed'    taken down — it leaves the list entirely
    //   title / summary      an optional rewording, shown wherever it is shown
    //
    // The list is public, so reads are open — a decision has to reach every
    // visitor, not only the maintainer. Only the maintainer writes one.
    //
    // NOTHING NEW PUBLISHES ITSELF (owner, 2026-08-18): an entry with NO
    // document here is withheld unless it predates the review gate. That rule
    // lives in lit/lit-news.js — the file the About page, the main page's alert
    // preview and the mailer all read it through — because ABSENCE cannot be
    // expressed in a rule at all. `hidden` is written in step with `status` so
    // a page served from an older cache reads a removal the same way.
    match /newsOverrides/{id} {
      allow read: if true;
      allow write: if isFeedbackAdmin()
                   && request.resource.data.keys()
                        .hasOnly(['status', 'hidden', 'title', 'summary', 't'])
                   && (!('status' in request.resource.data)
                       || request.resource.data.status in ['approved', 'pending', 'removed'])
                   && (!('hidden' in request.resource.data)
                       || request.resource.data.hidden is bool)
                   && (!('title' in request.resource.data)
                       || (request.resource.data.title is string
                           && request.resource.data.title.size() <= 300))
                   && (!('summary' in request.resource.data)
                       || (request.resource.data.summary is string
                           && request.resource.data.summary.size() <= 4000))
                   && (!('t' in request.resource.data)
                       || request.resource.data.t is number);
      /* A DECISION MUST NOT BE A ONE-WAY DOOR. `allow write` cannot cover a
         delete — `request.resource` is null on one, so
         `request.resource.data.keys()` errors and the condition is false. The
         normal way back from a removal is the "Removed updates" panel under
         the list, which only the maintainer sees; this keeps a document
         written wrongly from needing the Firestore console. */
      allow delete: if isFeedbackAdmin();
    }

  }
}
