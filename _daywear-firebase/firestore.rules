rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null && !exists(/databases/$(database)/documents/daywearRemovedUsers/$(request.auth.uid));}
  function admin(){return signedIn() && request.auth.token.get('daywearAdmin',false) == true;}
  function receipt(){return /databases/$(database)/documents/daywearFeedbackLimits/$(request.auth.uid);}
  match /daywearFeedback/{id} {
   // Missing-document reads support safe retry ids; existing feedback is owner-only.
   allow get: if signedIn() && (admin() || !exists(/databases/$(database)/documents/daywearFeedback/$(id)) || resource.data.uid == request.auth.uid);
   allow list: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
   allow delete: if signedIn() && resource.data.uid == request.auth.uid;
   allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['uid','message','name','email','emailVerified','language','status','screenshots','createdAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 6000
    && request.resource.data.name is string && request.resource.data.name.size() <= 80
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.emailVerified == request.auth.token.email_verified
    && request.resource.data.status == 'open'
    && request.resource.data.language in ['en','el']
    && request.resource.data.screenshots is string && request.resource.data.screenshots.size() <= 710000
    && request.resource.data.createdAt == request.time
    && (!exists(receipt()) || get(receipt()).data.lastSent + duration.value(60,'s') <= request.time)
    && getAfter(receipt()).data.lastSent == request.time
    && getAfter(receipt()).data.feedbackId == id;
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','replyDraft','reviewedAt'])
    && request.resource.data.status in ['open','in-progress','resolved']
    && request.resource.data.replyDraft is string && request.resource.data.replyDraft.size() <= 6000
    && request.resource.data.reviewedAt == request.time;
  }
  match /daywearProfiles/{uid} {
   allow read: if admin() || (signedIn() && uid == request.auth.uid);
   allow delete: if signedIn() && uid == request.auth.uid;
   allow create, update: if signedIn() && uid == request.auth.uid
    && request.resource.data.keys().hasOnly(['name','sizes','updatedAt'])
    && request.resource.data.name is string && request.resource.data.name.size() <= 50
    && request.resource.data.sizes is string && request.resource.data.sizes.size() <= 15000
    && request.resource.data.updatedAt == request.time;
   match /modelPreferences/{id} {allow read: if admin() || (signedIn() && uid == request.auth.uid); allow delete: if signedIn() && uid == request.auth.uid; allow create, update: if false;}
   match /selectedPosture/{id} {allow read: if admin() || (signedIn() && uid == request.auth.uid); allow delete: if signedIn() && uid == request.auth.uid; allow create, update: if false;}
   match /models/{id} {allow read: if admin() || (signedIn() && uid == request.auth.uid); allow delete: if signedIn() && uid == request.auth.uid; allow create, update: if false;}
   match /modelPreviews/{id} {allow read: if admin() || (signedIn() && uid == request.auth.uid); allow delete: if signedIn() && uid == request.auth.uid; allow create, update: if false;}
   match /photos/{id} {
    allow read: if admin() || (signedIn() && uid == request.auth.uid);
    allow delete: if signedIn() && uid == request.auth.uid;
    allow create, update: if signedIn() && uid == request.auth.uid && id.matches('[1-9]')
     && request.resource.data.keys().hasOnly(['name','data','kind','consentVersion','updatedAt'])
     && request.resource.data.get('kind','unclassified') in ['unclassified','headshot','body']
     && request.resource.data.name is string && request.resource.data.name.size() <= 120
     && request.resource.data.data is string && request.resource.data.data.size() <= 650000
     && request.resource.data.data.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
     && request.resource.data.consentVersion == 'daywear-testing-1'
     && request.resource.data.updatedAt == request.time;
   }
  }
  match /daywearFeedbackLimits/{uid} {
   allow read: if signedIn() && uid == request.auth.uid;
   allow create, update: if signedIn() && uid == request.auth.uid
    && request.resource.data.keys().hasOnly(['lastSent','feedbackId'])
    && request.resource.data.lastSent == request.time
    && request.resource.data.feedbackId is string && request.resource.data.feedbackId.size() <= 80
    && (!exists(receipt()) || resource.data.lastSent + duration.value(60,'s') <= request.time)
    && getAfter(/databases/$(database)/documents/daywearFeedback/$(request.resource.data.feedbackId)).data.uid == uid
    && getAfter(/databases/$(database)/documents/daywearFeedback/$(request.resource.data.feedbackId)).data.createdAt == request.time;
   allow delete: if false;
  }
  match /daywearUpdates/{id} {allow read: if true; allow write: if false;}
  match /daywearUpdateDrafts/{id} {
   allow read, delete: if admin();
   allow create, update: if admin()
    && request.resource.data.keys().hasOnly(['titleEn','titleEl','bodyEn','bodyEl','updatedAt'])
    && request.resource.data.titleEn is string && request.resource.data.titleEn.size()>0 && request.resource.data.titleEn.size()<=120
    && request.resource.data.titleEl is string && request.resource.data.titleEl.size()>0 && request.resource.data.titleEl.size()<=120
    && request.resource.data.bodyEn is string && request.resource.data.bodyEn.size()>0 && request.resource.data.bodyEn.size()<=4000
    && request.resource.data.bodyEl is string && request.resource.data.bodyEl.size()>0 && request.resource.data.bodyEl.size()<=4000
    && request.resource.data.updatedAt == request.time;
  }
  match /daywearUpdateSubscriptions/{uid} {
   allow read: if admin() || (signedIn() && uid == request.auth.uid);
   allow delete: if signedIn() && uid == request.auth.uid;
   allow create, update: if signedIn() && uid == request.auth.uid
    && request.resource.data.keys().hasOnly(['enabled','email','language','consentVersion','updatedAt'])
    && request.resource.data.enabled is bool
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.language in ['en','el']
    && request.resource.data.consentVersion == 'daywear-updates-1'
    && request.resource.data.updatedAt == request.time;
  }
  match /daywearUpdateMail/{id} {allow read: if admin(); allow write: if false;}
  match /daywearUpdateApprovals/{id} {allow read: if admin(); allow write: if false;}
  match /daywearAdminMessages/{id} {allow read: if admin(); allow write: if false;}
  match /daywearModelRequests/{id} {allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid); allow delete: if signedIn() && resource.data.uid == request.auth.uid; allow create, update: if false;}
  match /{document=**} {allow read, write: if false;}
 }
}
